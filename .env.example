# ИИ-ассистент первой линии (Gemini API)
GEMINI_API_KEY=
# Цепочка моделей: первая основная, остальные — если Google перегружен
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
# Кого тегать в топике, когда ИИ передаёт вопрос человеку (через пробел)
ADMIN_TAGS=@k1dl0
